# Cloudflare Pages / Netlify header rules.
# index.html must revalidate so a new notice shows up immediately;
# everything else is content-addressed enough to cache hard.

# security headers apply to everything, not just the entry page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # The CSS and JS are inlined into index.html by build_site.py, so
  # 'unsafe-inline' is required for script-src/style-src and no nonce can help
  # a statically hosted file. The policy still earns its place: default-src
  # 'self' denies every third-party origin, frame-src pins the only embed to
  # Google Maps, and object-src/base-uri close the two classic injection
  # escapes. form-action 'none' matches a site that submits nothing.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/notices/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

# the version is in the font filename, so a changed font is a changed URL
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600
